# Copy this file to .env and fill in your own values.
# Both variables are read only inside API routes, which run on the server,
# so they are never sent to the browser.

# Google AI Studio key: https://aistudio.google.com/
# Used for both the embedding model and the chat model.
GOOGLE_GENERATIVE_AI_API_KEY=

# MongoDB Atlas connection string, from Database > Connect > Drivers.
# Replace <db_username> and <db_password> with your database user credentials.
# In Atlas > Network Access, allow 0.0.0.0/0: serverless functions have no fixed IP.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=Docchat
